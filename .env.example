# Servidor
PORT=3000
NODE_ENV=development

# OpenAI (obligatoria)
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Límites de solicitudes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30

# Uploads
MAX_FILE_SIZE_MB=10

# Heurística de PDF escaneado (mínimo de caracteres extraídos localmente)
SCANNED_PDF_MIN_CHARS=200

# Documentos temporales del widget (memoria de una sola instancia)
# Copilot requiere una URL HTTPS pública en producción.
PUBLIC_BASE_URL=
DOCUMENT_UPLOAD_MAX_MB=10
DOCUMENT_TTL_SECONDS=900
DOCUMENT_STORE_MAX_MB=100
# Simulador oral (OpenAI Realtime; no requiere ElevenLabs)
INTERVIEW_ENABLED=false
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
INTERVIEW_MAX_SESSIONS=3
INTERVIEW_DURATION_SECONDS=600
# En producción usar HTTPS y una única instancia mientras el estado sea en memoria.
