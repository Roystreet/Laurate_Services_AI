# Servidor
PORT=3000
NODE_ENV=development

# OpenAI (obligatoria)
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Seguridad (API_KEY obligatoria en producción; si se define en desarrollo, también se exige)
API_KEY=cambia-esta-clave-secreta
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30

# Uploads
MAX_FILE_SIZE_MB=10

# Heurística de PDF escaneado (mínimo de caracteres extraídos localmente)
SCANNED_PDF_MIN_CHARS=200

# Documentos temporales del widget (memoria de una sola instancia)
# Copilot requiere una URL HTTPS pública en producción.
PUBLIC_BASE_URL=
DOCUMENT_UPLOAD_MAX_MB=10
DOCUMENT_TTL_SECONDS=900
DOCUMENT_STORE_MAX_MB=100
DOCUMENT_UPLOAD_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
